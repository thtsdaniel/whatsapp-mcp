+def _log(*args):
+    # stdout carries the MCP protocol, so diagnostics go to stderr
+    print(*args, file=sys.stderr)
+
+
+# The bridge's session store. Only the LID map and contact names are read, read-only.
+SESSION_DB_PATH = os.path.join(os.path.dirname(MESSAGES_DB_PATH), 'whatsapp.db')
+
+
+def _display_name(jid: Optional[str], stored: Optional[str]) -> Optional[str]:
+    """Best human name for a chat or sender.
+
+    The bridge stores the bare number as the name for newer "@lid" chats (upstream
+    issue #266). Map LID -> phone through whatsmeow_lid_map, then phone -> contact
+    name through whatsmeow_contacts; fall back to +phone.
+    """
+    if stored and not stored.isdigit():
+        return stored
+    if not jid or jid.endswith("@g.us"):
+        return stored or jid
+    user = jid.split('@')[0].split(':')[0]
+    try:
+        conn = sqlite3.connect(f"file:{SESSION_DB_PATH}?mode=ro", uri=True)
+        row = conn.execute("SELECT pn FROM whatsmeow_lid_map WHERE lid = ?", (user,)).fetchone()
+        phone = row[0] if row else user
+        row = conn.execute("""
+            SELECT COALESCE(NULLIF(full_name, ''), NULLIF(push_name, ''), NULLIF(business_name, ''), NULLIF(first_name, ''))
+            FROM whatsmeow_contacts WHERE their_jid = ?
+            LIMIT 1
+        """, (f"{phone}@s.whatsapp.net",)).fetchone()
+        conn.close()
+        if row and row[0]:
+            return row[0]
+        return f"+{phone}" if phone.isdigit() else (stored or jid)
+    except sqlite3.Error as e:
+        _log(f"Session store error while resolving name: {e}")
+        return stored or jid
