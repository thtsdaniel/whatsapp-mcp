+// The listener is bound to 127.0.0.1, but a web page can still reach it through
+// DNS rebinding; such a request carries the page's own hostname in Host.
+func isLoopbackHost(host string) bool {
+	if h, _, err := net.SplitHostPort(host); err == nil {
